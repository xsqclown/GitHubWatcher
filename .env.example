# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Primary recipient. A supergroup id usually starts with -100; a personal
# chat id is a positive number (ask @userinfobot for yours).
TELEGRAM_CHAT_ID=-1001234567890

# Topic (message_thread_id) inside a forum supergroup.
# 0 or empty posts to General. Open the topic in Telegram Web: the id is the
# last number in the URL.
TELEGRAM_TOPIC_ID=0

# Additional recipients, comma-separated. Each entry is "chat_id" or
# "chat_id:topic_id", so one bot can post to a forum topic, a plain group and
# a person's direct messages at the same time. Duplicates are ignored.
# Example: TELEGRAM_TARGETS=-1001234567890:42, -1009876543210, 123456789
TELEGRAM_TARGETS=

# Minimum gap between messages (guards against 429 Too Many Requests).
# Telegram allows roughly 20 messages per minute into one group.
TELEGRAM_SEND_INTERVAL=3s

# Deliver messages without a notification sound.
TELEGRAM_SILENT=false

# Announce in chat that the bot has started.
TELEGRAM_NOTIFY_ON_START=true

# Personal GitHub access token (classic: `repo` scope; fine-grained: Contents and
# Metadata, read-only). Without a token you get 60 requests per hour and no
# access to private repositories.
# For a private organisation repository a classic token must be SSO-authorised
# (Configure SSO -> Authorize); a fine-grained one must be created with the
# organisation as its resource owner.
# Verify access with: go run ./cmd/bot -check
GITHUB_TOKEN=ghp_ReplaceMe

# API base URL. For GitHub Enterprise: https://git.company.com/api/v3
GITHUB_API_URL=https://api.github.com

# How often to check the repositories.
POLL_INTERVAL=2m

# Random spread so requests do not arrive as one burst.
POLL_JITTER=15s

# How many repositories to check in parallel.
POLL_CONCURRENCY=4

# HTTP request timeout.
HTTP_TIMEOUT=20s

# Commits shown in one message; the rest collapse into "... and N more".
MAX_COMMITS_PER_MESSAGE=10

# Events of one kind per poll (guards against a flood after a force push).
MAX_EVENTS_PER_POLL=20

# IANA timezone for the timestamps in messages, e.g. Europe/Moscow.
TIMEZONE=Europe/Moscow

# Watched repositories and their display names.
REPOS_CONFIG=repos.json

# Message presentation: icons, wording, layout. Missing file means the
# built-in English defaults. Use messages.ru.json for Russian.
MESSAGES_CONFIG=messages.json

# State file, so restarts do not replay old events.
STATE_FILE=data/state.json

# debug | info | warn | error
LOG_LEVEL=info

# text | json
LOG_FORMAT=text

# HTTP healthcheck address; empty disables it. Endpoints: /healthZ, /readyZ
HEALTH_ADDR=
